diff --git a/source/display_modes.hpp b/source/display_modes.hpp
new file mode 100644
--- /dev/null
+++ b/source/display_modes.hpp
@@ -0,0 +1,26 @@
+/** Windowed backbuffers need not be physical monitor modes. */
+#pragma once
+#include <d3d9.h>
+#include <vector>
+
+inline void AppendWindowedDisplayModes(std::vector<D3DDISPLAYMODE>& modes,
+    IDirect3D9* proxy, UINT adapter, UINT width, UINT height) {
+    D3DDISPLAYMODE desktop = {};
+    if (width < 640 || width > 7680 || height < 480 || height > 5760 ||
+        width * 3 != height * 4 || FAILED(proxy->GetAdapterDisplayMode(adapter, &desktop))) return;
+    const D3DFORMAT formats[] = {D3DFMT_X8R8G8B8, D3DFMT_A8R8G8B8};
+    for (D3DFORMAT format : formats) {
+        if (FAILED(proxy->CheckDeviceType(adapter, D3DDEVTYPE_HAL, desktop.Format, format, TRUE))) continue;
+        bool exists = false;
+        for (const D3DDISPLAYMODE& mode : modes) {
+            if (mode.Width == width && mode.Height == height && mode.Format == format) {
+                exists = true;
+                break;
+            }
+        }
+        if (!exists) {
+            D3DDISPLAYMODE mode = {width, height, desktop.RefreshRate, format};
+            modes.push_back(mode);
+        }
+    }
+}
diff --git a/source/presentation.hpp b/source/presentation.hpp
new file mode 100644
--- /dev/null
+++ b/source/presentation.hpp
@@ -0,0 +1,13 @@
+#pragma once
+#include "presentation_window.h"
+#include <d3d9.h>
+
+inline void ConfigureBorderlessCopy(D3DPRESENT_PARAMETERS& parameters) {
+    // Present(destination rectangle) requires COPY, one buffer and no MSAA.
+    parameters.Windowed = TRUE;
+    parameters.SwapEffect = D3DSWAPEFFECT_COPY;
+    parameters.BackBufferCount = 1;
+    parameters.MultiSampleType = D3DMULTISAMPLE_NONE;
+    parameters.MultiSampleQuality = 0;
+    parameters.FullScreen_RefreshRateInHz = 0;
+}
diff --git a/source/presentation_window.h b/source/presentation_window.h
new file mode 100644
--- /dev/null
+++ b/source/presentation_window.h
@@ -0,0 +1,73 @@
+#pragma once
+#include <windows.h>
+
+static __inline DWORD BorderlessStyle(DWORD style) {
+    return (style & ~(WS_CAPTION | WS_THICKFRAME | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) | WS_POPUP | WS_CLIPCHILDREN;
+}
+
+static __inline DWORD BorderlessExStyle(DWORD style) {
+    return (style & ~(WS_EX_WINDOWEDGE | WS_EX_CLIENTEDGE | WS_EX_STATICEDGE | WS_EX_DLGMODALFRAME)) | WS_EX_APPWINDOW;
+}
+
+static __inline RECT FitFourByThree(LONG width, LONG height) {
+    RECT result = {0, 0, 0, 0};
+    LONG pictureWidth, pictureHeight;
+    if (width <= 0 || height <= 0) return result;
+    pictureWidth = width;
+    pictureHeight = (LONG)((long long)width * 3 / 4);
+    if (pictureHeight > height) {
+        pictureHeight = height;
+        pictureWidth = (LONG)((long long)height * 4 / 3);
+    }
+    result.left = (width - pictureWidth) / 2;
+    result.top = (height - pictureHeight) / 2;
+    result.right = result.left + pictureWidth;
+    result.bottom = result.top + pictureHeight;
+    return result;
+}
+
+static __inline BOOL EnforceBorderlessWindow(HWND window) {
+    MONITORINFO monitor;
+    RECT client, picture, bars[4];
+    BOOL resized;
+    int index;
+    WNDCLASSW blackClass;
+    HINSTANCE instance = GetModuleHandleW(NULL);
+    const WCHAR* blackClassName = L"PSOBB_Letterbox_v3";
+    monitor.cbSize = sizeof(monitor);
+    if (!IsWindow(window) || !GetMonitorInfoW(MonitorFromWindow(window, MONITOR_DEFAULTTONEAREST), &monitor)) return FALSE;
+    SetWindowLongPtrW(window, GWL_STYLE, (LONG_PTR)BorderlessStyle((DWORD)GetWindowLongPtrW(window, GWL_STYLE)));
+    SetWindowLongPtrW(window, GWL_EXSTYLE, (LONG_PTR)BorderlessExStyle((DWORD)GetWindowLongPtrW(window, GWL_EXSTYLE)));
+    resized = SetWindowPos(window, NULL, monitor.rcMonitor.left, monitor.rcMonitor.top,
+        monitor.rcMonitor.right - monitor.rcMonitor.left, monitor.rcMonitor.bottom - monitor.rcMonitor.top,
+        SWP_FRAMECHANGED | SWP_NOACTIVATE | SWP_NOZORDER | SWP_NOOWNERZORDER);
+    if (!resized || !GetClientRect(window, &client)) return FALSE;
+    picture = FitFourByThree(client.right, client.bottom);
+    SetRect(&bars[0], 0, 0, picture.left, client.bottom);
+    SetRect(&bars[1], picture.right, 0, client.right, client.bottom);
+    SetRect(&bars[2], picture.left, 0, picture.right, picture.top);
+    SetRect(&bars[3], picture.left, picture.bottom, picture.right, client.bottom);
+    ZeroMemory(&blackClass, sizeof(blackClass));
+    if (!GetClassInfoW(instance, blackClassName, &blackClass)) {
+        blackClass.lpfnWndProc = DefWindowProcW;
+        blackClass.hInstance = instance;
+        blackClass.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
+        blackClass.lpszClassName = blackClassName;
+        if (!RegisterClassW(&blackClass)) return FALSE;
+    }
+    // Opaque non-interactive child bars repaint after occlusion; do not rely on
+    // undefined pixels outside a partial Direct3D Present destination.
+    for (index = 0; index < 4; ++index) {
+        HWND bar = GetDlgItem(window, 0x7f01 + index);
+        LONG width = bars[index].right - bars[index].left;
+        LONG height = bars[index].bottom - bars[index].top;
+        if (!bar) bar = CreateWindowExW(WS_EX_NOACTIVATE, blackClassName, L"", WS_CHILD | WS_DISABLED,
+            0, 0, 0, 0, window, (HMENU)(INT_PTR)(0x7f01 + index), instance, NULL);
+        if (!bar) return FALSE;
+        if (width > 0 && height > 0) {
+            SetWindowPos(bar, HWND_TOP, bars[index].left, bars[index].top, width, height,
+                SWP_NOACTIVATE | SWP_SHOWWINDOW);
+        } else ShowWindow(bar, SW_HIDE);
+    }
+    return TRUE;
+}
